{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://dfc/schemas/fleet/deployable_feature.json",
    "title": "DFC Deployable Feature Data",
    "description": "Data file for a Deployable Feature. RulesExample is only present when the rules text ends with an example.",
    "type": "object",
    "required": ["Profile", "Weapons", "Load", "Rules"],
    "additionalProperties": false,
    "properties": {
        "Profile": { "$ref": "#/$defs/DeployProfile" },
        "Weapons": { "type": "array", "items": { "$ref": "#/$defs/DeployWeapon" } },
        "Load":    { "type": "array", "items": { "$ref": "https://dfc/schemas/defs.json#/$defs/LoadEntry" } },
        "Rules":   { "type": "string" },
        "RulesExample": { "type": "string" }
    },
    "$defs": {
        "DeployProfile": {
            "description": "The stat-line of a Deployable Feature.",
            "type": "object",
            "required": ["PTS", "Type", "ES", "KS", "Special"],
            "additionalProperties": false,
            "properties": {
                "PTS":     { "description": "Points cost, or null if variable.", "type": ["integer", "null"] },
                "Type":    { "description": "The name of the Deployable Feature.", "type": "string" },
                "ES":      { "$ref": "https://dfc/schemas/defs.json#/$defs/SaveValue" },
                "KS":      { "$ref": "https://dfc/schemas/defs.json#/$defs/SaveValue" },
                "Special": { "type": "array", "items": { "type": "string" } }
            }
        },
        "DeployWeaponProfile": {
            "description": "A single firing profile within a multi-profile Deployable Feature weapon.",
            "type": "object",
            "required": ["Name", "Scan", "Att", "Lock", "DMG", "Type", "Special"],
            "additionalProperties": false,
            "properties": {
                "Name":    { "type": "string" },
                "Scan":    { "description": "Scan range in inches, or null when absent.", "type": ["integer", "null"] },
                "Att":     { "type": "integer" },
                "Lock":    { "$ref": "https://dfc/schemas/defs.json#/$defs/LockValue" },
                "DMG":     { "type": "integer" },
                "Type":    { "$ref": "https://dfc/schemas/defs.json#/$defs/WeaponType" },
                "Special": { "type": "array", "items": { "type": "string" } }
            }
        },
        "DeploySingleWeapon": {
            "description": "A Deployable Feature weapon with a single firing profile. Rule is only present when the feature has a rule sharing the weapon's name.",
            "type": "object",
            "required": ["Name", "Scan", "Att", "Lock", "DMG", "Type", "Special"],
            "additionalProperties": false,
            "properties": {
                "Name":    { "type": "string" },
                "Scan":    { "description": "Scan range in inches, or null when absent.", "type": ["integer", "null"] },
                "Att":     { "type": "integer" },
                "Lock":    { "$ref": "https://dfc/schemas/defs.json#/$defs/LockValue" },
                "DMG":     { "type": "integer" },
                "Type":    { "$ref": "https://dfc/schemas/defs.json#/$defs/WeaponType" },
                "Special": { "type": "array", "items": { "type": "string" } },
                "Rule":    { "type": "string" }
            }
        },
        "DeployMultiProfileWeapon": {
            "description": "A Deployable Feature weapon with multiple named firing profiles. Rule is only present when the feature has a rule sharing the weapon's name.",
            "type": "object",
            "required": ["Name", "Profiles"],
            "additionalProperties": false,
            "properties": {
                "Name":     { "type": "string" },
                "Profiles": { "type": "array", "items": { "$ref": "#/$defs/DeployWeaponProfile" }, "minItems": 2 },
                "Rule":     { "type": "string" }
            }
        },
        "DeployWeapon": {
            "description": "A weapon on a Deployable Feature: either a single-profile weapon or a multi-profile weapon.",
            "oneOf": [
                { "$ref": "#/$defs/DeploySingleWeapon" },
                { "$ref": "#/$defs/DeployMultiProfileWeapon" }
            ]
        }
    }
}
