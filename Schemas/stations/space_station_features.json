{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://dfc/schemas/stations/space_station_features.json",
    "title": "DFC Space Station Features",
    "description": "The priced Space Station Features table.",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "required": ["Name", "Pts", "ES", "KS", "Hull", "Effect", "Effects"],
        "additionalProperties": false,
        "properties": {
            "Name":    { "type": "string", "minLength": 1 },
            "Pts":     { "type": "integer", "minimum": 0 },
            "ES":      { "$ref": "https://dfc/schemas/defs.json#/$defs/SaveValue" },
            "KS":      { "$ref": "https://dfc/schemas/defs.json#/$defs/SaveValue" },
            "Hull":    { "type": "integer", "minimum": 1 },
            "Effect":  { "type": "string", "minLength": 1 },
            "Effects": {
                "description": "Profile modifiers the Feature applies to the station that takes it; empty when its Effect changes no profile stat.",
                "type": "array",
                "items": { "$ref": "https://dfc/schemas/defs.json#/$defs/StatModifier" }
            }
        }
    }
}
