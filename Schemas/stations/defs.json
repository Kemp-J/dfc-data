{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://dfc/schemas/stations/defs.json",
    "title": "DFC Station Shared Definitions",
    "$defs": {
        "StationProfile": {
            "description": "Space station stat-line.",
            "type": "object",
            "required": ["Scan", "Sig", "Hull", "ES", "KS", "BS", "G", "Special"],
            "additionalProperties": false,
            "properties": {
                "Scan":    { "type": "integer" },
                "Sig":     { "type": "integer" },
                "Hull":    { "type": "integer" },
                "ES":      { "$ref": "https://dfc/schemas/defs.json#/$defs/SaveValue" },
                "KS":      { "$ref": "https://dfc/schemas/defs.json#/$defs/SaveValue" },
                "BS":      { "$ref": "https://dfc/schemas/defs.json#/$defs/SaveOrDash" },
                "G":       { "$ref": "https://dfc/schemas/defs.json#/$defs/GValue" },
                "Special": { "type": "array", "items": { "type": "string" } }
            }
        },
        "MinMax": {
            "type": "object",
            "required": ["Min", "Max"],
            "additionalProperties": false,
            "properties": {
                "Min": { "type": "integer", "minimum": 0 },
                "Max": { "type": "integer", "minimum": 0 }
            }
        },
        "Hardpoints": {
            "description": "What a station has automatically and what it may add. Features are free and each Name matches an entry in space_station_features.json. AdditionalFeatures counts extra Features bought from that file. Armaments counts options from space_station_armaments.json.",
            "type": "object",
            "required": ["Features", "AdditionalFeatures", "Armaments"],
            "additionalProperties": false,
            "properties": {
                "Features": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["Name", "Count"],
                        "additionalProperties": false,
                        "properties": {
                            "Name":  { "type": "string" },
                            "Count": { "type": "integer", "minimum": 1 }
                        }
                    }
                },
                "AdditionalFeatures": { "$ref": "#/$defs/MinMax" },
                "Armaments":          { "$ref": "#/$defs/MinMax" }
            }
        }
    }
}
